# ─── Required ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Tables use Row Level Security with no public policies, so the app
# reads and writes with this key. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio → API keys
GEMINI_API_KEY=

# Resend → API Keys. Leave blank until you're ready to send.
RESEND_API_KEY=
# A verified Resend sender, e.g. "Arjun at Kargo <hiring@yourdomain.com>".
# For testing without a domain: onboarding@resend.dev (delivers only to your Resend account email).
HIRING_FROM_EMAIL=

# Sign-in for the dashboard (it holds candidate PII). Use a long random SESSION_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=
SESSION_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────
# Booking page included in interview invites (Cal.com / Calendly). Without it,
# invites ask the candidate to reply with times.
SCHEDULING_URL=
# Deliver every email here instead of the candidate (testing).
RESEND_TEST_RECIPIENT=
# Replies go here if set.
HIRING_REPLY_TO=
# Defaults to gemini-flash-latest.
GEMINI_MODEL=
# Only for `npm run db:setup` (direct Postgres connection string). Not needed on Vercel.
SUPABASE_DB_URL=
